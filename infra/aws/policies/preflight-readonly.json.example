{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectOnlyNamedImageRepositories",
      "Effect": "Allow",
      "Action": "ecr:DescribeRepositories",
      "Resource": [
        "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/rizz-staging-frontend",
        "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/rizz-staging-backend",
        "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/rizz-app",
        "arn:aws:ecr:us-east-1:ACCOUNT_ID:repository/rizz-backend"
      ]
    },
    {
      "Sid": "InspectOnlyNamedClusters",
      "Effect": "Allow",
      "Action": "eks:DescribeCluster",
      "Resource": [
        "arn:aws:eks:us-east-1:ACCOUNT_ID:cluster/rizz-eks-staging",
        "arn:aws:eks:us-east-1:ACCOUNT_ID:cluster/rizz-cluster"
      ]
    },
    {
      "Sid": "InspectRegionalNetworkMetadata",
      "Effect": "Allow",
      "Action": "ec2:DescribeVpcs",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "InspectOnlyPublisherRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/rizz-staging-image-publisher"
    },
    {
      "Sid": "InspectOnlyGitHubOidcProvider",
      "Effect": "Allow",
      "Action": "iam:GetOpenIDConnectProvider",
      "Resource": "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "CheckOnlyProposedStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::STATE_BUCKET_NAME"
    }
  ]
}
