{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "start:github": "AGENT_GUARD_AUTH_MODE=github BACKSTAGE_ENV=github node --env-file-if-exists=.env .yarn/releases/yarn-4.13.0.cjs start",
    "start:portal": "AGENT_GUARD_AUTH_MODE=github BACKSTAGE_ENV=github,gitops,rizz-local node --env-file-if-exists=.env --env-file-if-exists=.env.delivery.local .yarn/releases/yarn-4.13.0.cjs start",
    "start:portal:kind": "AGENT_GUARD_AUTH_MODE=github BACKSTAGE_ENV=github,gitops,kubernetes,rizz-local node --env-file-if-exists=.env --env-file-if-exists=.env.delivery.local .yarn/releases/yarn-4.13.0.cjs start",
    "start:portal:releases": "node scripts/require-local-config.mjs app-config.rizz-releases.local.yaml && AGENT_GUARD_AUTH_MODE=github BACKSTAGE_ENV=github,gitops,rizz-local,rizz-releases node --env-file-if-exists=.env --env-file-if-exists=.env.delivery.local .yarn/releases/yarn-4.13.0.cjs start",
    "start:portal:cloud": "node scripts/require-local-config.mjs app-config.rizz-releases.local.yaml app-config.rizz-cloud.local.yaml && AGENT_GUARD_AUTH_MODE=github BACKSTAGE_ENV=github,gitops,rizz-local,rizz-releases,rizz-cloud node --env-file-if-exists=.env --env-file-if-exists=.env.delivery.local .yarn/releases/yarn-4.13.0.cjs start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
