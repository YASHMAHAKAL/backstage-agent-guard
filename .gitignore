# macOS
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory generated when running tests with coverage
coverage

# Dependencies
node_modules/

# Yarn files
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Node version directives
.nvmrc

# dotenv environment variables file
.env
.env.test
.env.delivery.local
.env.*
!.env.example

# Build output
dist
dist-types

# Temporary change files created by Vim
*.swp

# MkDocs build output
site

# Local configuration files
*.local.yaml

# Sensitive credentials
*-credentials.yaml
*.pem
*.key
*.p12
*.pfx
id_ed25519*
kubeconfig*
.kube/
.codex/
examples/github-users.yaml

# vscode database functionality support files
*.session.sql

# E2E test reports
e2e-test-report/

# Cache
.cache/
# Local Backstage demo database
var/*.sqlite
var/*.sqlite-*

# Terraform working data, credentials/identity inputs and saved plans.
# Commit provider lockfiles and placeholder examples, never state or plans.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
*.tfvars
*.tfvars.json
!/infra/aws/environments/staging/capacity.auto.tfvars.json
*.backend.hcl
!.terraform.lock.hcl
!*.tfvars.example
!*.backend.hcl.example
# Operator cloud-render inputs contain account/network metadata; never commit.
/infra/cloud-platform/config.local.json
/infra/cloud-platform/alb-demo.config.local.json
/infra/cloud-platform/*.rendered.yaml
/app-config.rizz-releases.local.yaml
# Cloud target/config contains operator-specific metadata; never commit it.
app-config.rizz-cloud.local.yaml
